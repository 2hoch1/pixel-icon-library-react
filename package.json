{
  "$schema": "https://json.schemastore.org/package",
  "name": "@2hoch1/pixel-icon-library-react",
  "version": "2.0.0",
  "description": "React wrapper for the HackerNoon Pixel Icon Library.",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./icon-types": {
      "types": "./dist/icon-types.d.ts",
      "import": "./dist/icon-types.js",
      "require": "./dist/icon-types.cjs"
    },
    "./dynamicIconImports": {
      "types": "./dist/dynamicIconImports.d.ts",
      "import": "./dist/dynamicIconImports.js",
      "require": "./dist/dynamicIconImports.cjs"
    },
    "./icons": {
      "types": "./dist/icons/index.d.ts",
      "import": "./dist/icons/index.js",
      "require": "./dist/icons/index.cjs"
    },
    "./icons/*": {
      "types": "./dist/icons/*.d.ts",
      "import": "./dist/icons/*.js",
      "require": "./dist/icons/*.cjs"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "sideEffects": false,
  "scripts": {
    "generate": "tsx scripts/generate-icons.ts",
    "build": "npm run generate && tsup",
    "clean": "rimraf dist",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write --no-error-on-unmatched-pattern \"src/**/*.{ts,tsx,mts}\" \"tests/**/*.{ts,tsx,mts}\" \"scripts/**/*.{ts,tsx,mts}\" \"*.{json,md,yml,yaml}\" \".github/**/*.{yml,yaml,json,md}\"",
    "format:check": "prettier --check --no-error-on-unmatched-pattern \"src/**/*.{ts,tsx,mts}\" \"tests/**/*.{ts,tsx,mts}\" \"scripts/**/*.{ts,tsx,mts}\" \"*.{json,md,yml,yaml}\" \".github/**/*.{yml,yaml,json,md}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "npm run build && changeset publish",
    "prepare": "husky",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "react": ">=18.0.0 <20.0.0"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@commitlint/cli": "^19.0.0",
    "@commitlint/config-conventional": "^19.0.0",
    "@commitlint/types": "^20.4.4",
    "@eslint/js": "^9.0.0",
    "@hackernoon/pixel-icon-library": "^1.1.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@types/node": "^25.0.3",
    "@types/react": "^18.3.12",
    "@vitejs/plugin-react": "^5.1.2",
    "@vitest/coverage-v8": "^4.0.0",
    "esbuild": "^0.25.2",
    "esbuild-plugin-svgr": "^3.1.1",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "happy-dom": "^20.1.0",
    "husky": "^9.0.0",
    "lint-staged": "^15.0.0",
    "prettier": "^3.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "rimraf": "^6.0.1",
    "tsup": "^8.3.0",
    "tsx": "^4.19.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.0",
    "vitest": "^4.0.16"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/2hoch1/pixel-icon-library-react.git"
  },
  "homepage": "https://github.com/2hoch1/pixel-icon-library-react",
  "bugs": {
    "url": "https://github.com/2hoch1/pixel-icon-library-react/issues"
  }
}
